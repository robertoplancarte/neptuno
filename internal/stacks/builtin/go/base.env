# Variables {{.Name}} gets in every configuration.
PORT={{.Port}}
# The database server comes from PGHOST, PGPORT, PGUSER and PGPASSWORD in
# environments/_shared/base.env, which Postgres clients read. Name the
# database where each environment is set up, for example
# PGDATABASE={{.Name}}_development in local.env and {{.Name}}_test in the
# command that runs the tests, rather than here, where every process,
# tests included, would get the same one.
