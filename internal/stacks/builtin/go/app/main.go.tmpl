package main

import (
	"fmt"
	"log"
	"net/http"
	"os"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "{{.Port}}"
	}
	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		fmt.Fprintln(w, "Hello from {{.Name}}")
	})
	log.Printf("{{.Name}} listening on %s", port)
	log.Fatal(http.ListenAndServe(":"+port, nil))
}
