# Variables {{.Name}} gets in every configuration.
PORT={{.Port}}
# The database server comes from PGHOST, PGPORT, PGUSER and PGPASSWORD in
# environments/_shared/base.env, and each environment's database name from
# config/database.yml, so tests use the test database. Don't set DATABASE_URL
# here with a database name in it: Rails would use that name in every
# environment, so tests would run against the development database.
