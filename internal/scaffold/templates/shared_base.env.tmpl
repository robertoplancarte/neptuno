# Variables every repo gets, in every configuration.
# Resolution order (later wins): _shared/base.env, _shared/<config>.env,
# <repo>/base.env, <repo>/<config>.env, _shared/*.local.env,
# <repo>/*.local.env, --set flags. *.local.env files are git-ignored personal
# overrides; put one in _shared/ to give every repo a value.
{{range .Services}}{{.Env}}{{end -}}
